# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 自動回答対象のチャンネルID (カンマ区切りで複数指定可)
TARGET_CHANNEL_IDS=123456789012345678

# 回答に使うClaudeモデル (実行者)
CLAUDE_MODEL=claude-sonnet-4-6

# 要返答判定に使う軽量モデル (お礼・雑談へのフル回答をスキップ)
GATE_MODEL=claude-haiku-4-5

# Advisor Strategy: 判断に迷った時に相談する上位モデル
ADVISOR_MODEL=claude-opus-4-8
ADVISOR_MAX_USES=2

# システムプロンプト (ボットの振る舞いをカスタマイズ)
SYSTEM_PROMPT=あなたはDiscordサーバーの親切なアシスタントです。質問に対して簡潔で分かりやすい日本語で回答してください。

# サーバー履歴の取得設定
HISTORY_FETCH_LIMIT=200
HISTORY_DAYS=30

# 現在の会話文脈の取得設定
CONVERSATION_CONTEXT_LIMIT=20
CONVERSATION_CONTEXT_MINUTES=180
MAX_CONVERSATION_CONTEXT_CHARS=6000

# サーバー履歴コンテキストのキャッシュ秒数 (この間隔でのみDiscordから再取得)
SERVER_CONTEXT_TTL_SECONDS=120

# 優先チャンネル履歴の保持件数 (起動時取得・メモリ保持の上限)
PRIORITY_HISTORY_LIMIT=1000

# Studioガイドの再取得間隔 (秒)
STUDIO_GUIDE_REFRESH_SECONDS=21600

# 全履歴を取得する優先チャンネル名 (カンマ区切り、部分一致で判定)
PRIORITY_CHANNEL_NAMES=トラブルシューティング,troubleshoot

# Notion API (ユーザーガイド取得 — 最優先データソース)
# https://www.notion.so/my-integrations でInternal Integrationを作成し、
# ユーザーガイドのページと訂正ナレッジDBにIntegrationを接続してください
NOTION_TOKEN=

# 訂正ナレッジDB ID (!訂正 / !ナレッジ抽出 の保存先)
# DB properties: Topic(title), Correction(rich_text), Question(rich_text), WrongAnswer(rich_text)
NOTION_CORRECTIONS_DB_ID=

# GitHub リポジトリ設定 (ファームウェア情報の取得に使用)
GITHUB_REPO=pite1222/conductor
GITHUB_BRANCH=zephyr-4.1
GITHUB_TOKEN=
